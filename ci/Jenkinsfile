// Jenkins: nightly Playwright run with AI auto-healing.
//
// Place this Jenkinsfile in your TEST repository.
// Configure credentials (Manage Jenkins -> Credentials):
//   azure-openai-key   (Secret text)  -> AZURE_OPENAI_API_KEY
//   gh-token           (Secret text)  -> token for opening the PR
//
// The healer runs only when the test stage fails.

pipeline {
  agent any

  triggers {
    cron('H 2 * * *')   // ~02:00 daily
  }

  environment {
    AI_MODE                 = 'azure-openai'
    AZURE_OPENAI_ENDPOINT   = 'https://your-endpoint.openai.azure.com/'
    AZURE_OPENAI_DEPLOYMENT = 'gpt-4o'
    AZURE_OPENAI_API_KEY    = credentials('azure-openai-key')
    GH_TOKEN                = credentials('gh-token')
  }

  stages {
    stage('Install') {
      steps {
        sh 'npm ci'
        sh 'npx playwright install --with-deps'
      }
    }

    stage('Test') {
      steps {
        // Capture failure instead of aborting, so the heal stage can run.
        script {
          env.TESTS_FAILED = '0'
          def code = sh(script: 'npx playwright test --trace on', returnStatus: true)
          if (code != 0) { env.TESTS_FAILED = '1' }
        }
      }
    }

    stage('Auto-heal') {
      when { expression { env.TESTS_FAILED == '1' } }
      steps {
        sh 'pip install git+https://github.com/bunnycodec/auto_healing_framework.git'
        sh 'auto-healer heal test-results --auto-pr'
      }
    }
  }

  post {
    always {
      archiveArtifacts artifacts: 'test-results/**, reports/**', allowEmptyArchive: true
    }
    success {
      script {
        if (env.TESTS_FAILED == '1') {
          echo 'Tests failed; auto-healer ran. Review the opened PR.'
          currentBuild.result = 'UNSTABLE'
        }
      }
    }
  }
}
