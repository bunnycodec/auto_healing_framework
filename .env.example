# Python/FastAPI layer
# rule is deterministic and useful for local smoke tests.
# Use azure-openai, ollama, or kilo for AI-backed healing.
AI_MODE=rule
OLLAMA_MODEL=qwen3:8b
OLLAMA_URL=http://localhost:11434/api/generate

# Use when AI_MODE=kilo
KILO_API_KEY=
KILO_API_URL=https://api.kilo.ai/v1/messages
KILO_MODEL=claude-sonnet

PLAYWRIGHT_PROJECT_ROOT=playwright-tests
TEST_COMMAND=npx playwright test --grep @smoke --trace on
REPORTS_DIR=reports
HEALER_TEMP_DIR=trace-output

# TypeScript CLI layer
# Supported providers: openai, azure-openai, anthropic, gemini
LLM_PROVIDER=azure-openai

# OpenAI
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o

# Azure OpenAI
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_DEPLOYMENT=
AZURE_OPENAI_API_VERSION=2025-04-01-preview

# Anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-20250514

# Google Gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-pro

# Git/PR automation
GIT_REMOTE=origin
GIT_BASE_BRANCH=main