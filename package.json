{
  "name": "playwright-self-heal",
  "version": "1.0.0",
  "description": "Framework-agnostic self-healing tool for Playwright test suites. Analyzes trace files, classifies failures, auto-fixes broken locators, and raises PRs.",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "self-heal": "dist/cli/index.js"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "lint": "eslint src --ext .ts",
    "test": "jest --passWithNoTests",
    "self-heal": "ts-node src/cli/index.ts"
  },
  "keywords": [
    "playwright",
    "self-healing",
    "test-automation",
    "auto-fix",
    "locator"
  ],
  "license": "MIT",
  "dependencies": {
    "commander": "^12.1.0",
    "chalk": "^4.1.2",
    "jszip": "^3.10.1",
    "glob": "^10.3.10",
    "simple-git": "^3.22.0",
    "ora": "^5.4.1",
    "dotenv": "^16.4.5"
  },
  "devDependencies": {
    "typescript": "^5.4.5",
    "@types/node": "^20.11.0",
    "ts-node": "^10.9.2",
    "jest": "^29.7.0",
    "ts-jest": "^29.1.2",
    "@types/jest": "^29.5.12",
    "eslint": "^8.57.0",
    "@typescript-eslint/eslint-plugin": "^7.0.0",
    "@typescript-eslint/parser": "^7.0.0"
  }
}
